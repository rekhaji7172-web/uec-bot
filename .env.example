# Discord Developer Portal -> Bot -> Token
DISCORD_TOKEN=your_bot_token_here

# Jis server par test karna hai (instant slash commands ke liye, optional)
GUILD_ID=

# Scenepack search channel (comma se multiple)
CHANNEL_ID=1513842246586208266

# OpenRouter API key (AI ke liye) - https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: specific free model (khali chhodo toh auto best free model choose hoga)
AI_MODEL=

# Optional but RECOMMENDED: Google Gemini free key (bada free tier, 1500 req/day)
# Free key: https://aistudio.google.com/apikey  (Gemini set hoga toh pehle woh use hoga)
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional but RECOMMENDED: YouTube Data API v3 key (!stats accurate data ke liye)
# 1. https://console.cloud.google.com/ → naya project banao
# 2. APIs & Services → Library → "YouTube Data API v3" Enable karo
# 3. APIs & Services → Credentials → Create credentials → API key → copy yahan paste karo
# Key nahi hoga toh bot HTML scraping se chalega (chalta hai, API se exact data aata hai)
YOUTUBE_API_KEY=
